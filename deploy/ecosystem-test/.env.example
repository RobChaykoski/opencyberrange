# Dev-only training ecosystem. Replace every value before use; never commit .env.
# These are LAB credentials. Do not reuse them anywhere real.

# Moodle
MOODLE_DB_ROOT_PASSWORD=change-this-root-password
MOODLE_DB_PASSWORD=change-this-moodle-password
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change-this-admin-password
MOODLE_ADMIN_EMAIL=admin@example.invalid
MOODLE_SITE_URL=http://localhost:8091
MOODLE_PORT=8091
MOODLE_TLS_PORT=9443
# Set to the reachable dev host (for example 172.16.16.44) when testing LTI.
MOODLE_TLS_HOST=localhost

# Authentik (optional sso profile)
AUTHENTIK_VERSION=2026.8.5
AUTHENTIK_DB_PASSWORD=change-this-authentik-db-password
AUTHENTIK_SECRET_KEY=change-this-to-a-long-random-secret
AUTHENTIK_PORT=9000

# NetBox (optional assets profile)
NETBOX_DB_PASSWORD=change-this-netbox-db-password
NETBOX_SECRET_KEY=lab-only-netbox-secret-key-change-me-0123456789abcdefghijklmnopqrstuvwxyz
NETBOX_ADMIN_EMAIL=admin@example.invalid
NETBOX_ADMIN_PASSWORD=change-this-netbox-admin-password
NETBOX_PORT=8083

# Ralph (optional assets profile)
RALPH_DB_PASSWORD=change-this-ralph-db-password
RALPH_SECRET_KEY=change-this-to-a-long-random-ralph-secret
RALPH_ADMIN_USER=admin
RALPH_ADMIN_EMAIL=admin@example.invalid
RALPH_ADMIN_PASSWORD=change-this-ralph-admin-password
RALPH_PORT=8084

# Fleet (optional endpoint profile)
FLEET_DB_PASSWORD=change-this-fleet-db-password
FLEET_DB_ROOT_PASSWORD=change-this-fleet-root-password
FLEET_ADMIN_EMAIL=admin@example.invalid
FLEET_ADMIN_NAME=Training Admin
FLEET_ADMIN_PASSWORD=change-this-fleet-admin-password
FLEET_PORT=8082
RALPH_DB_ROOT_PASSWORD=change-this-ralph-root-password

# Bind address. Keep loopback by default. Set to 172.16.16.44 on the dev host
# only when a learner or the dev range must reach the service.
MOODLE_BIND=127.0.0.1
MOODLE_TLS_BIND=127.0.0.1
AUTHENTIK_BIND=127.0.0.1
NETBOX_BIND=127.0.0.1
RALPH_BIND=127.0.0.1
FLEET_BIND=127.0.0.1

# Fake learner/staff password used by the Moodle seeder.
TRAINING_PASSWORD=TrainLab!2026#Student
