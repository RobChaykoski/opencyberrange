# Staging Moodle for https://<moodle-host>
#
# Generate strong unique values. Do not reuse training-lab or production
# secrets. Keep this file out of version control.

MOODLE_DB_ROOT_PASSWORD=replace-with-a-long-random-root-password
MOODLE_DB_PASSWORD=replace-with-a-long-random-moodle-db-password

# Keep the Moodle administrator username as "admin" only if you need the
# ecosystem seed scripts to create course tools. Use a unique strong password.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
MOODLE_ADMIN_EMAIL=admin@example.com

MOODLE_SITE_URL=https://moodle.example.com
MOODLE_TLS_HOST=moodle.example.com
# Hostname of the production platform; used to refuse a mispointed staging URL.
OCR_PUBLIC_HOST=platform.example.com
ACME_EMAIL=admin@example.com

# Fake demo accounts only. Set this before running seed_staging.sh. Never use a
# real learner password or a production credential.
# TRAINING_PASSWORD=replace-with-a-demo-only-password

# Optional image pins. Pin a tested tag before the event.
# STAGING_MOODLE_IMAGE=bitnamilegacy/moodle:latest
# STAGING_MARIADB_IMAGE=bitnamilegacy/mariadb:latest

# Direct Moodle HTTP is loopback-only for debugging; Caddy is the public entry.
# MOODLE_DEBUG_PORT=8092

# Public TLS ports. The local preview override uses 9080/9444 instead.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
