# Production pilot Moodle for https://moodle.swocts.com
#
# Generate strong unique values. Do not reuse staging, training, or repository
# secrets. Keep this file out of version control.

MOODLE_DB_ROOT_PASSWORD=replace-with-a-long-random-root-password
MOODLE_DB_PASSWORD=replace-with-a-long-random-moodle-db-password

MOODLE_ADMIN_USER=admin
