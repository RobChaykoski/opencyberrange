# Copy to a private deployment environment. Do not commit the real file.
# The administrator supplies the organization-owned license details at deploy
# time. This file contains no product key, MAK key, or KMS key.

WINDOWS_LICENSE_SOURCE=evaluation
WINDOWS_MEDIA_PATH=
WINDOWS_MEDIA_SHA256=
# Only when WINDOWS_LICENSE_SOURCE=kms. This is a hostname, not a key.
WINDOWS_KMS_HOST=
