# Copy to .env on the production host, mode 600. Generate every value.
# Never commit the real file.

AUTHENTIK_VERSION=2026.8.5

# Public name and NPM upstream. NPM terminates TLS and forwards to this host.
AUTHENTIK_HOST=https://auth.swocts.com
AUTHENTIK_COOKIE_DOMAIN=auth.swocts.com
AUTHENTIK_BIND=172.16.16.41

# Generated secrets (openssl rand -base64 48 / hex).
AUTHENTIK_SECRET_KEY=
AUTHENTIK_DB_PASSWORD=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=

# Initial administrator. Replace with the operator's real address.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@swocts.com
