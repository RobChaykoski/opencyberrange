# Cloudflare API token, scoped to Zone:DNS:Edit for swocts.com only.
# Create it at Cloudflare -> My Profile -> API Tokens -> Edit zone DNS.
CLOUDFLARE_API_TOKEN=replace-with-scoped-cloudflare-api-token

# Public records that must follow the firewall's WAN address.
# Keep this list minimal and explicit.
DDNS_DOMAINS=moodle.swocts.com,ctfd.swocts.com

# false keeps NPM responsible for TLS and Let's Encrypt validation.
# true is for Cloudflare-proxied records; configure an origin certificate.
DDNS_PROXIED=false

# Detect the public IPv4 via Cloudflare's trace endpoint.
DDNS_IP4_PROVIDER=cloudflare.trace
DDNS_IP6_PROVIDER=none

# Update every five minutes, and after container restart.
DDNS_UPDATE_CRON=*/5 * * * *

# Optional image pin after testing.
# CLOUDFLARE_DDNS_IMAGE=favonia/cloudflare-ddns:latest
