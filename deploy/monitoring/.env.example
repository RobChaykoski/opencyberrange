# Copy to .env, chmod 600, and replace every value.
# Do not commit .env.

# Grafana is published as https://health.swocts.com through Nginx Proxy Manager.
GRAFANA_ROOT_URL=https://health.swocts.com
GRAFANA_DOMAIN=health.swocts.com

# Bootstrap administrator. Keep the local login form enabled until OIDC and the
# admin group work, then set GRAFANA_DISABLE_LOGIN_FORM=true and keep the
# password in the institution password manager.
GRAFANA_ADMIN_USER=ops-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
GRAFANA_DISABLE_LOGIN_FORM=false
# Keep true behind HTTPS. Set false only for a localhost test.
GRAFANA_COOKIE_SECURE=true

# Bind address for Grafana. Keep 127.0.0.1 when NPM runs on the same host.
# Set a private management address when NPM runs on another host.
GRAFANA_BIND=127.0.0.1

# Authentik OIDC application for the monitoring dashboard.
# Redirect URI: https://health.swocts.com/login/generic_oauth
GRAFANA_OIDC_ENABLED=true
GRAFANA_OIDC_NAME=Authentik
GRAFANA_OIDC_CLIENT_ID=replace-with-authentik-client-id
GRAFANA_OIDC_CLIENT_SECRET=replace-with-authentik-client-secret
GRAFANA_OIDC_SCOPES="openid profile email"
GRAFANA_OIDC_AUTH_URL=https://<auth-host>/application/o/authorize/
GRAFANA_OIDC_TOKEN_URL=https://<auth-host>/application/o/token/
GRAFANA_OIDC_API_URL=https://<auth-host>/application/o/userinfo/
GRAFANA_OIDC_ROLE_PATH="contains(groups[*], 'swocts-platform-admins') && 'Admin' || 'Viewer'"
GRAFANA_OIDC_TLS_SKIP_VERIFY=false
# Allow the first OIDC login to create the Grafana user. Access is still
# restricted by the Authentik application policy.
GRAFANA_OIDC_ALLOW_SIGN_UP=true

# Alertmanager receiver. Replace with the institution webhook or relay.
# Alertmanager does not expand environment variables inside its YAML; keep the
# URL in alertmanager/alertmanager.yml or mount a generated file.
ALERT_WEBHOOK_URL=https://hooks.example.com/services/replace-me
