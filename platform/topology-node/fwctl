#!/usr/bin/env python3
"""Scoped nftables helper for topology nodes.

The node runs with ``no-new-privileges``, so ``sudo`` and setuid helpers cannot
raise privileges. The entrypoint (PID 1, root) exposes a Unix socket that only
accepts ``show`` and ``apply <file under /srv/fw>``. That is enough for the
firewall labs and nothing else: no shell, no arbitrary path, no command line.

Usage:
    fwctl show
    fwctl apply /srv/fw/policy.nft
"""
from __future__ import annotations

import socket
import sys

SOCKET_PATH = "/run/fwctl.sock"
USAGE = "usage: fwctl show | fwctl apply <file under /srv/fw>\n"


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] == "show":
        request = "show"
    elif len(argv) == 3 and argv[1] == "apply":
        request = f"apply {argv[2]}"
    else:
        sys.stderr.write(USAGE)
        return 2

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.connect(SOCKET_PATH)
            client.sendall((request + "\n").encode("utf-8"))
            chunks = []
            while True:
                chunk = client.recv(65536)
                if not chunk:
                    break
                chunks.append(chunk)
    except OSError as exc:
        sys.stderr.write(f"fwctl: {exc}\n")
        return 1

    status, _, body = b"".join(chunks).decode("utf-8", "replace").partition("\n")
    sys.stdout.write(body)
    if status != "ok":
        sys.stderr.write("fwctl: the policy was rejected\n")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
