# Local-only credentials for the simulated cloud range.
# Copy to .env and change every value before use.
# These defaults are deliberately obvious and must never reach a shared host.

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

MINIO_ROOT_USER=ocr-cloud-admin
MINIO_ROOT_PASSWORD=change-me-minio

VAULT_DEV_ROOT_TOKEN=change-me-vault

N8N_BASIC_AUTH_USER=ocr
N8N_BASIC_AUTH_PASSWORD=change-me-n8n

OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
